# Security headers for every static page (Cloudflare Workers static assets). API responses are
# produced by the Worker and are JSON only.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://cdn.jsdelivr.net https://*.clerk.accounts.dev https://clerk.devicebasedauth.org https://challenges.cloudflare.com; connect-src 'self' https://*.clerk.accounts.dev https://clerk.devicebasedauth.org https://clerk-telemetry.com; img-src 'self' data: https://img.clerk.com; style-src 'self' 'unsafe-inline'; font-src 'self'; worker-src 'self' blob:; frame-src https://challenges.cloudflare.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()

# The SDK is loaded by other sites.
/sdk/*
  Access-Control-Allow-Origin: *

# Released SDK versions never change (scripts/build-sdk.mjs refuses to overwrite one): cache forever.
# Access-Control-Allow-Origin comes from /sdk/* above: Cloudflare applies every matching rule, and
# a second copy is sent as "*, *", which browsers refuse for cross-origin module scripts.
/sdk/:version/*
  Cache-Control: public, max-age=31536000, immutable

/lib/*
  Access-Control-Allow-Origin: *
