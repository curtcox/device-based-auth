{
  "name": "devicebasedauth-org",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Revocable, device-bound authentication and authorization",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "wrangler dev",
    "dev:local": "wrangler dev --config wrangler.local.toml --local",
    "deploy": "wrangler deploy",
    "lint": "eslint --ext .js,.mjs src packages scripts spec docs/samples frontend/js frontend/sdk test-utils --no-error-on-unmatched-pattern",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:samples": "node scripts/run-samples.mjs",
    "vectors:generate": "node scripts/generate-vectors.mjs",
    "docs:generate": "node scripts/generate-openapi.mjs && node scripts/sync-browser-lib.mjs && node scripts/build-sdk.mjs",
    "status": "grep -E '⬜|🚧|🟨|❓' STATUS.md"
  },
  "author": "Curt Cox",
  "license": "MIT",
  "dependencies": {
    "@clerk/backend": "2.33.9",
    "stripe": "14.25.0"
  },
  "devDependencies": {
    "@playwright/test": "1.57.0",
    "eslint": "8.57.1",
    "vitest": "5.0.3",
    "wrangler": "4.153.0",
    "vite": "8.3.8",
    "esbuild": "0.28.2"
  }
}
