diff --git a/src/api/dba.js b/src/api/dba.js
new file mode 100644
index 0000000..d03423e
--- /dev/null
+++ b/src/api/dba.js
@@ -0,0 +1,77 @@
+import { assert, readJson, ApiError } from '../utils/errors.js';
+import { rpc } from '../utils/rpc.js';
+import { dbaIssuer, dbaOidc } from '../auth/dba.js';
+
+const DBA_ACCOUNT = /^[A-Za-z0-9_-]{1,128}$/;
+const free = { quote_microdollars: 0, cost_microdollars: 0 };
+
+/**
+ * Link, inspect and unlink the account's devicebasedauth.org account (all SESSION routes).
+ * Linking is free like signing in, and limited to 10 operations a minute per account.
+ */
+export async function dbaLink(route, request, env, auth) {
+  const dryRun = new URL(request.url).searchParams.get('dry_run') === '1';
+  switch (route.handler) {
+    case 'dba-link-status': return status(env, auth.account);
+    case 'dba-link-start': {
+      if (dryRun) return free;
+      await rpc(env.ACCOUNTS, auth.account, 'rate-limit', { id: 'dba-link', limit: 10 });
+      const { url, state } = await reach(() => dbaOidc(env).begin());
+      const { expires_at } = await rpc(env.ACCOUNTS, auth.account, 'dba-link-begin', { oidc: state });
+      return { url, expires_at };
+    }
+    case 'dba-link-finish': {
+      const body = await readJson(request, 8192);
+      assert(typeof body.code === 'string' && body.code.length > 0 && body.code.length <= 2048, 'invalid_code', 'Expected the authorization code from devicebasedauth.org');
+      assert(typeof body.state === 'string' && body.state.length > 0 && body.state.length <= 256, 'invalid_state', 'Expected the state from devicebasedauth.org');
+      if (dryRun) return free;
+      await rpc(env.ACCOUNTS, auth.account, 'rate-limit', { id: 'dba-link', limit: 10 });
+      const { oidc } = await rpc(env.ACCOUNTS, auth.account, 'dba-link-take', { state: body.state });
+      const claims = await reach(() => dbaOidc(env).finish({ code: body.code, state: body.state }, oidc));
+      const dbaAccount = claims.acct ?? claims.sub;
+      assert(typeof dbaAccount === 'string' && DBA_ACCOUNT.test(dbaAccount), 'dba_link_failed', 'devicebasedauth.org did not name an account', 502);
+      await claim(env, dbaAccount, auth.account);
+      // The index claim comes first and the account row confirms it; until both agree the link
+      // authorizes nothing, so an interruption here cannot let credentials in.
+      const { previous } = await rpc(env.ACCOUNTS, auth.account, 'dba-link-set', { dba_account: dbaAccount, subject: claims.sub, issuer: dbaIssuer(env) });
+      if (previous && previous !== dbaAccount) await rpc(env.DBA_LINKS, previous, 'release', { account: auth.account });
+      return status(env, auth.account);
+    }
+    case 'dba-link-delete': {
+      if (dryRun) return free;
+      await rpc(env.ACCOUNTS, auth.account, 'rate-limit', { id: 'dba-link', limit: 10 });
+      // Clear the confirming row first: credentials stop working even if the release fails.
+      const { previous } = await rpc(env.ACCOUNTS, auth.account, 'dba-unlink');
+      if (previous) await rpc(env.DBA_LINKS, previous, 'release', { account: auth.account });
+      return status(env, auth.account);
+    }
+  }
+}
+
+/** Claim the DBA account for this cronly account, taking over only a claim nobody confirms. */
+async function claim(env, dbaAccount, account) {
+  let result = await rpc(env.DBA_LINKS, dbaAccount, 'claim', { account });
+  if (result.claimed) return;
+  const holder = await rpc(env.ACCOUNTS, result.account, 'dba-link-status');
+  assert(holder.dba_account !== dbaAccount, 'dba_account_linked', 'This devicebasedauth.org account is already linked to another cronly account; unlink it there first', 409);
+  result = await rpc(env.DBA_LINKS, dbaAccount, 'claim', { account, replace: result.account });
+  assert(result.claimed, 'dba_account_linked', 'This devicebasedauth.org account is already linked to another cronly account; unlink it there first', 409);
+}
+
+/** The account's view, confirmed against the global index (a superseded link reads as unlinked). */
+async function status(env, account) {
+  const view = await rpc(env.ACCOUNTS, account, 'dba-link-status');
+  const active = view.linked && (await rpc(env.DBA_LINKS, view.dba_account, 'get')).account === account;
+  return { ...view, linked: active, superseded: view.linked && !active, issuer: dbaIssuer(env), ...free };
+}
+
+/** Call devicebasedauth.org; its failures become stable public errors without its prose. */
+async function reach(operation) {
+  try { return await operation(); } catch (error) {
+    if (error instanceof ApiError) throw error;
+    // Library errors carry an OAuth/verification code; anything else is a network failure.
+    const reason = typeof error?.code === 'string' && /^[a-z_]{1,64}$/.test(error.code) ? error.code : null;
+    if (!reason) throw new ApiError(502, 'dba_unavailable', 'devicebasedauth.org could not be reached; try again');
+    throw new ApiError(400, 'dba_link_failed', 'devicebasedauth.org did not confirm the link; start again', { reason });
+  }
+}
diff --git a/src/api/dba.test.js b/src/api/dba.test.js
new file mode 100644
index 0000000..9a2fff3
--- /dev/null
+++ b/src/api/dba.test.js
@@ -0,0 +1,106 @@
+import { it, expect, beforeEach, afterEach, vi } from 'vitest';
+import worker from '../index.js';
+import { AccountDO } from '../durable-objects/account-do.js';
+import { JobDO } from '../durable-objects/job-do.js';
+import { DbaLinkDO } from '../durable-objects/dba-link-do.js';
+import { DBA_STATE_TTL_MS } from '../durable-objects/dba-account.js';
+import { namespace } from '../../test-utils/storage.js';
+import { fakeDbaIssuer } from '../../test-utils/dba-issuer.js';
+import { rpc } from '../utils/rpc.js';
+
+let env; let dba;
+beforeEach(async () => {
+  dba = await fakeDbaIssuer(); vi.stubGlobal('fetch', (...args) => dba.fetch(...args));
+  env = { ENVIRONMENT: 'local', APP_ORIGIN: 'https://cronly.org', DBA_ISSUER: dba.issuer };
+  env.ACCOUNTS = namespace(AccountDO, env); env.JOBS = namespace(JobDO, env); env.DBA_LINKS = namespace(DbaLinkDO, env);
+});
+afterEach(() => { vi.unstubAllGlobals(); vi.useRealTimers(); });
+
+const call = async (user, method, path, body) => {
+  const response = await worker.fetch(new Request(`https://cronly.org${path}`, { method, headers: { Authorization: `LocalDev ${user}`, 'Content-Type': 'application/json' }, body: body === undefined ? undefined : JSON.stringify(body) }), env);
+  return { status: response.status, body: await response.json() };
+};
+async function link(user, acct) {
+  const start = await call(user, 'POST', '/api/dba/link/start');
+  expect(start.status).toBe(200);
+  return call(user, 'POST', '/api/dba/link/finish', dba.authorize(start.body.url, { acct }));
+}
+
+it('links, reports and unlinks a devicebasedauth.org account through OIDC with PKCE', async () => {
+  const start = await call('alice', 'POST', '/api/dba/link/start');
+  const query = Object.fromEntries(new URL(start.body.url).searchParams);
+  expect(start.body.url.startsWith(`${dba.issuer}/oauth/authorize?`)).toBe(true);
+  expect(query).toMatchObject({ response_type: 'code', client_id: 'cronly.org', redirect_uri: 'https://cronly.org/auth/dba/callback', code_challenge_method: 'S256' });
+  // The PKCE verifier and nonce stay server-side.
+  expect(JSON.stringify(start.body)).not.toContain('verifier');
+  expect(start.body).toMatchObject({ cost_microdollars: 0 });
+
+  const finish = await call('alice', 'POST', '/api/dba/link/finish', dba.authorize(start.body.url, { acct: 'dba_alice' }));
+  expect(finish).toMatchObject({ status: 200, body: { linked: true, dba_account: 'dba_alice', issuer: dba.issuer, credentials: [], cost_microdollars: 0 } });
+  expect(await rpc(env.DBA_LINKS, 'dba_alice', 'get')).toEqual({ account: 'alice' });
+  expect((await call('alice', 'GET', '/api/dba/link')).body).toMatchObject({ linked: true, dba_account: 'dba_alice' });
+  expect((await call('alice', 'GET', '/api/audit')).body.items).toEqual([expect.objectContaining({ kind: 'link_dba', dba_account: 'dba_alice' })]);
+
+  const unlinked = await call('alice', 'DELETE', '/api/dba/link');
+  expect(unlinked).toMatchObject({ status: 200, body: { linked: false, dba_account: null } });
+  expect(await rpc(env.DBA_LINKS, 'dba_alice', 'get')).toEqual({ account: null });
+});
+
+it('links one devicebasedauth.org account to at most one cronly account', async () => {
+  expect((await link('alice', 'dba_shared')).status).toBe(200);
+  expect(await link('bob', 'dba_shared')).toMatchObject({ status: 409, body: { code: 'dba_account_linked' } });
+  expect((await call('bob', 'GET', '/api/dba/link')).body).toMatchObject({ linked: false });
+  await call('alice', 'DELETE', '/api/dba/link');
+  expect(await link('bob', 'dba_shared')).toMatchObject({ status: 200, body: { linked: true, dba_account: 'dba_shared' } });
+});
+
+it('takes over a claim that its holder no longer confirms, and releases the old account on relink', async () => {
+  // An interrupted link: the index names alice, but alice's account never recorded it.
+  await rpc(env.DBA_LINKS, 'dba_orphan', 'claim', { account: 'alice' });
+  expect(await link('bob', 'dba_orphan')).toMatchObject({ status: 200, body: { linked: true } });
+  expect(await rpc(env.DBA_LINKS, 'dba_orphan', 'get')).toEqual({ account: 'bob' });
+
+  expect((await link('bob', 'dba_next')).body).toMatchObject({ linked: true, dba_account: 'dba_next' });
+  expect(await rpc(env.DBA_LINKS, 'dba_orphan', 'get')).toEqual({ account: null });
+});
+
+it('reports a link superseded in the index as not linked', async () => {
+  await link('alice', 'dba_raced');
+  await rpc(env.DBA_LINKS, 'dba_raced', 'claim', { account: 'bob', replace: 'alice' });
+  expect((await call('alice', 'GET', '/api/dba/link')).body).toMatchObject({ linked: false, superseded: true, dba_account: 'dba_raced' });
+});
+
+it('uses each OIDC state once, expires it, and rejects malformed or refused callbacks', async () => {
+  const start = await call('alice', 'POST', '/api/dba/link/start');
