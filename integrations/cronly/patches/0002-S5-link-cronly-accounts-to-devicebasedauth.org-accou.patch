+import { createOidcClient } from '../vendor/devicebasedauth/site.js';
+
+/** cronly's audience and OIDC client id at devicebasedauth.org. */
+export const DBA_AUDIENCE = 'cronly.org';
+export const DBA_DEFAULT_ISSUER = 'https://devicebasedauth.org';
+
+/** The devicebasedauth.org issuer this deployment trusts. */
+export function dbaIssuer(env) { return env.DBA_ISSUER || DBA_DEFAULT_ISSUER; }
+
+// Resolve fetch per call so tests (and a future instrumented fetch) can replace the global.
+const fetcher = (...args) => globalThis.fetch(...args);
+
+/**
+ * OIDC client for linking a cronly account to a DBA account (authorization code + PKCE).
+ * Built per link request on purpose: linking is rare, and the vendored client caches discovery
+ * and JWKS bodies without checking the HTTP status, so a module-level client could keep a
+ * transient error response for the life of the isolate.
+ */
+export function dbaOidc(env) {
+  return createOidcClient({ clientId: DBA_AUDIENCE, redirectUri: `${env.APP_ORIGIN}/auth/dba/callback`, issuer: dbaIssuer(env), fetch: fetcher });
+}
